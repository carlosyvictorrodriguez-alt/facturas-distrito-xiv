rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /facturas/{fileName} {
      allow create: if request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow read: if true;
      allow delete: if request.auth != null;
    }
  }
}
