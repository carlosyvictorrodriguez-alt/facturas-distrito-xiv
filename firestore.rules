rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /facturas/{invoiceId} {
      allow create: if request.resource.data.keys().hasAll(['userId','establishment','amount','date','filename','imageUrl'])
                    && request.resource.data.userId is string
                    && request.resource.data.establishment is string
                    && request.resource.data.amount is string
                    && request.resource.data.filename is string
                    && request.resource.data.imageUrl is string;
      allow read, update, delete: if request.auth != null;
    }
  }
}
